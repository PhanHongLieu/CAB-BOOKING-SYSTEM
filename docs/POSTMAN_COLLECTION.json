{
  "info": {
    "_postman_id": "cab-booking-system",
    "name": "CAB Booking System",
    "description": "Complete API collection for testing the CAB Booking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Customer\",\n  \"phone\": \"0123456789\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "http://localhost:3001/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3001/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/api/auth/verify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "auth", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "Booking Service",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLocation\": {\n    \"address\": \"123 Main Street, City\",\n    \"coordinates\": {\n      \"lat\": 10.762622,\n      \"lng\": 106.660172\n    }\n  },\n  \"dropoffLocation\": {\n    \"address\": \"456 Park Avenue, City\",\n    \"coordinates\": {\n      \"lat\": 10.773928,\n      \"lng\": 106.702315\n    }\n  },\n  \"vehicleType\": \"economy\"\n}"
            },
            "url": {
              "raw": "http://localhost:3002/api/bookings",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3002/api/bookings?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3002/api/bookings/{{booking_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings", "{{booking_id}}"]
            }
          }
        },
        {
          "name": "Accept Booking (Driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3002/api/bookings/{{booking_id}}/accept",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings", "{{booking_id}}", "accept"]
            }
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "http://localhost:3002/api/bookings/{{booking_id}}/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings", "{{booking_id}}", "status"]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
            },
            "url": {
              "raw": "http://localhost:3002/api/bookings/{{booking_id}}/cancel",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["api", "bookings", "{{booking_id}}", "cancel"]
            }
          }
        }
      ]
    },
