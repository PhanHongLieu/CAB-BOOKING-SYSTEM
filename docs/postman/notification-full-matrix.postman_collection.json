{
  "info": {
    "_postman_id": "d8f9d50a-8b28-4a6f-bcc3-85f8245298df",
    "name": "CAB Notification Full Matrix",
    "description": "Full matrix for notification-service: core API, negative tests, and optional event-driven tests via RabbitMQ HTTP API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Core API",
      "item": [
        {
          "name": "Auth - Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"123456\",\n  \"name\": \"Matrix User\",\n  \"phone\": \"0987654321\",\n  \"role\": \"customer\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 or 400', function () {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth - Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.data.accessToken);",
                  "pm.collectionVariables.set('user_id', json.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Send",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"type\": \"system\",\n  \"title\": \"Hello\",\n  \"message\": \"Full matrix manual notification\",\n  \"data\": {\n    \"source\": \"postman-matrix\"\n  }\n}"
            },
            "url": "{{base_url}}/api/notifications/send"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('send success', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('notification_id', json.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Get My Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get notifications success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Get Unread Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications?unreadOnly=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get unread success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Mark As Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications/{{notification_id}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mark read success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Mark All Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mark all read success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Negative",
      "item": [
        {
          "name": "Notification - Get Without Token",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthorized 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Send Missing Required Fields",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\"\n}"
            },
            "url": "{{base_url}}/api/notifications/send"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('validation error 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Mark Non Existent ID",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications/64b7c3b6e4a7d2f1b0f00000/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not found 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Event-Driven (Optional)",
      "item": [
        {
          "name": "RabbitMQ Publish - payment.completed",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitmq_user}}", "type": "string" },
                { "key": "password", "value": "{{rabbitmq_pass}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {},\n  \"routing_key\": \"payment.completed\",\n  \"payload\": \"{\\\"eventType\\\":\\\"payment.completed\\\",\\\"data\\\":{\\\"paymentId\\\":\\\"pm_001\\\",\\\"bookingId\\\":\\\"bk_001\\\",\\\"customerId\\\":\\\"{{user_id}}\\\"},\\\"timestamp\\\":\\\"2026-03-01T00:00:00.000Z\\\",\\\"service\\\":\\\"postman\\\"}\",\n  \"payload_encoding\": \"string\"\n}"
            },
            "url": "{{rabbitmq_api}}/api/exchanges/%2F/{{event_exchange}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rabbitmq publish accepted', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.routed).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification - Get After payment.completed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contains event notification', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  const found = (json.data || []).some(n => n.type === 'payment_completed');",
                  "  pm.expect(found).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "test_email", "value": "notification_matrix@example.com" },
    { "key": "access_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "notification_id", "value": "" },
    { "key": "rabbitmq_api", "value": "http://localhost:15672" },
    { "key": "rabbitmq_user", "value": "admin" },
    { "key": "rabbitmq_pass", "value": "admin123" },
    { "key": "event_exchange", "value": "cab_booking_events" }
  ]
}
