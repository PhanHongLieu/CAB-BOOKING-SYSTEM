{
  "info": {
    "_postman_id": "d97ef70e-85aa-4e7f-ae0e-4ce8d15df8f5",
    "name": "CAB Notification Service",
    "description": "Tests for notification-service via API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"123456\",\n  \"name\": \"Postman User\",\n  \"phone\": \"0987654321\",\n  \"role\": \"customer\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201 or 400 (already exists)', function () {",
              "  pm.expect([201, 400]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"123456\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login success', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('access_token', json.data.accessToken);",
              "pm.collectionVariables.set('user_id', json.data.user.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Notification - Send",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"type\": \"system\",\n  \"title\": \"Hello\",\n  \"message\": \"Test notification from Postman\",\n  \"data\": {\n    \"source\": \"postman\"\n  }\n}"
        },
        "url": "{{base_url}}/api/notifications/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('send success', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('notification_id', json.data._id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Notification - Get My Notifications",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/api/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('get notifications success', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Notification - Mark As Read",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/api/notifications/{{notification_id}}/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('mark read success', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Notification - Mark All Read",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/api/notifications/read-all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('mark all read success', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "test_email", "value": "notification_tester@example.com" },
    { "key": "access_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "notification_id", "value": "" }
  ]
}
