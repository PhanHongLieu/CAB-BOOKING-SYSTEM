# Payment Service Configuration

# Server
NODE_ENV=development
PORT=3004
SERVICE_NAME=payment-service

# PostgreSQL Database Configuration
DB_HOST=postgres-payment
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=payment_db
DATABASE_URL=postgresql://admin:admin123@postgres-payment:5432/payment_db

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672
EVENT_EXCHANGE=cab_booking_events

# External Services
AUTH_SERVICE_URL=http://auth-service:3001
BOOKING_SERVICE_URL=http://booking-service:3002
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# Frontend
FRONTEND_URL=http://localhost:3000

# Distributed Tracing (Jaeger)
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLE_RATE=1.0

# Payment Gateway Configuration (Optional)
STRIPE_SECRET_KEY=your-stripe-secret-key
VNPAY_MERCHANT_ID=your-vnpay-merchant-id
VNPAY_HASH_SECRET=your-vnpay-hash-secret
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
